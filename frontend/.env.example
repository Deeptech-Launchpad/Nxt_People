# Copy this to frontend/.env and fill in real values.
# All Vite env vars must be prefixed VITE_ to be exposed to the bundle.

# ── Sentry (optional) ───────────────────────────────────────────────────────
# Leave blank to disable browser error tracking. The SDK is a no-op without a DSN.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=

# Note:
# • The frontend talks to the backend via relative paths (/api/, /uploads/).
#   In dev, the Vite proxy in vite.config.js routes them to localhost:5000.
#   In prod, nginx (see nginx/nginx.conf) routes them to the backend container.
# • There is NO VITE_API_URL — adding one would re-introduce the kind of
#   environment-coupling we deliberately avoid.
