.env
.env.*
!.env.example
**/.env

# Build output
dist/
build/
**/dist/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vite writes these while building and does not always clean them up
frontend/vite.config.js.timestamp-*

# Built from whatever is in frontend/public/covers, every build. Tracking it
# means anybody who adds or removes a banner locally gets a modified file they
# did not edit, and a merge conflict on a file nobody writes by hand.
frontend/public/covers/manifest.json

# Uploaded files. On the server this holds real employee documents — Aadhaar
# and PAN scans, certificates, photos. A `git add -A` there swept 129 of them
# into a commit; the push happened to fail for want of credentials, which is
# the only reason they did not reach GitHub. They are never source.
backend/uploads/

# One-off import data pulled out of Zoho. Holds employee leave balances.
/balances.csv

# Stray copies of frontend/public/covers/* that land in the repo root.
/coast.jpg
/forest.jpg
/leaves.jpg
/mountains.jpg
/road.jpg
/space.jpg
