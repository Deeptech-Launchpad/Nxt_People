# Copy this file to backend/.env and fill in real values.
# .env is git-ignored — never commit real secrets.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
# Default to "production". Set to "development" only for local dev so verbose
# error traces and lax rate-limiting kick in. docker-compose.prod.yml also
# overrides this to production, so leaving it accidentally on "development"
# in the .env will NOT bleed into the live deploy — but every other code
# path (running `node server.js` directly, tests, scripts) honours this var.
NODE_ENV=production

# In production these MUST be your real public URL (e.g. https://hr.acme.com).
# Required when NODE_ENV=production — the server now refuses to start with
# a missing CORS_ORIGIN to avoid silently allowing only localhost.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

COMPANY_NAME=Nxt People

# Bootstrap admin(s). On server startup, every email listed here is checked
# against the employees table. Missing rows are created with role=admin and
# no password — those admins log in by visiting /login → "Forgot password"
# and following the link they receive by email.
#
# Multiple admins are supported via commas (or semicolons / whitespace).
# Safe to leave set across restarts — never overwrites or elevates existing
# rows; promotion of an existing employee to admin is a manual UI action.
#
# Examples:
#   ADMIN_EMAIL=balaji@altiusnxt.com
#   ADMIN_EMAIL=balaji@altiusnxt.com, manikandan@altiusnxt.com
ADMIN_EMAIL=balaji@altiusnxt.com

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nxt_people

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotating JWT_SECRET invalidates every issued token — all users get logged out.
JWT_SECRET=
JWT_ACCESS_EXPIRE=15m
JWT_EXPIRE=7d

# ── SMTP (used for password-reset and onboarding emails) ────────────────────
# Gmail caps personal accounts at ~500/day, Workspace at ~2,000/day. For larger
# rollouts or burst sends (e.g., onboarding 70 users at once) prefer a
# transactional provider: SendGrid, Postmark, Brevo, or AWS SES. All have free
# tiers sufficient for an internal HR tool.
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ── Zoho People integration (optional) ──────────────────────────────────────
# Leave blank to disable the admin-triggered sync. Endpoints return 503 when
# unconfigured so the UI degrades gracefully.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://people.zoho.in
ZOHO_AUTH_URL=https://accounts.zoho.in/oauth/v2/token

# ── Error monitoring (optional) ─────────────────────────────────────────────
# Leave blank to disable. With a DSN set, 5xx responses and uncaught exceptions
# stream to Sentry. Sample rate gates traces, not error events (errors always
# capture). 0.1 = 10% of requests carry full traces; tune for cost.
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Logging ─────────────────────────────────────────────────────────────────
# Optional. Defaults to "debug" in development, "info" in production.
# Set to "warn" or "error" if pino's output is overwhelming your log shipper.
LOG_LEVEL=

# ── Operational escape hatch ────────────────────────────────────────────────
# Set RATE_LIMIT_DISABLED=true to bypass auth rate limits temporarily (e.g.
# during an onboarding storm). Restart required. Remove after the burst.
RATE_LIMIT_DISABLED=

# ── Google Sign-In (optional) ───────────────────────────────────────────────
# Enables "Sign in with Google" using official company accounts only. Leave
# GOOGLE_CLIENT_ID blank to disable the whole feature (the button hides itself
# and POST /api/auth/google returns 503).
#
# 1. In Google Cloud Console -> APIs & Services -> Credentials, create an
#    "OAuth client ID" of type "Web application".
# 2. Add your frontend origin(s) under "Authorized JavaScript origins"
#    (e.g. http://localhost:5173 and your production URL).
# 3. Put the generated Client ID here AND in frontend/.env as
#    VITE_GOOGLE_CLIENT_ID (they must match).
GOOGLE_CLIENT_ID=981002835126-5cnvmt801mv858v2cvsuith9n1g5nsdh.apps.googleusercontent.com
# Comma-separated company domains allowed to sign in. Only Google accounts whose
# verified email is on one of these domains are accepted. Defaults to altiusnxt.com.
GOOGLE_ALLOWED_DOMAINS=altiusnxt.com

# Developer machines only: refuses every outgoing message and logs it instead.
# Never set this on the live server.
EMAIL_DISABLED=false

# Developer machines only: the ONLY addresses that may be written to. Every other
# recipient is dropped before the message is built, so a test run cannot reach a
# colleague. Leave empty on the live server or nobody receives anything.
EMAIL_ALLOWLIST=
